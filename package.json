{
  "name": "@thready-web/dsh-bot-plugin",
  "version": "0.1.0-beta.4",
  "type": "module",
  "description": "DSH bot plugin: session persona, memory, work, hash routing, and the workbench. Pinned to @deepseek-ai/dsh 0.2.2-rc.1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thready-web/dsh-bot-plugin.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http-plugin.js",
    "./router": "./dist/router-plugin.js",
    "./client": "./client.js",
    "./engine": "./dist/engine.js",
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "client.js",
    "fixtures",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "node build.mjs",
    "type-check": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/unit-tests.mjs",
    "test:host": "npm run build && node --test test/host-integration.test.ts && node --test test/triggers-host.test.ts && node --test test/budget-host.test.ts && node --test test/activity-host.test.ts && node --test test/work-host.test.ts && node --test test/work-bash-host.test.ts",
    "format": "biome format --write src test ui/src client.js scripts",
    "format:check": "biome check src test ui/src client.js scripts"
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.2.2-rc.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.15",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compat": {
      "package": "@deepseek-ai/dsh",
      "version": "0.2.2-rc.1"
    }
  }
}
